# vscode
.vscode 

# Intellij
*.iml
.idea

# npm
node_modules

# Don't include the compiled main.js file in the repo.
# They should be uploaded to GitHub releases instead.
main.js

# Generated by the build: src/styles/base.css plus whatever the *.module.css
# imports compiled to. Edit src/styles/base.css, not this.
styles.css

# Exclude sourcemaps
*.map

# obsidian
data.json

# Exclude macOS Finder (System Explorer) View States
.DS_Store

# Local dev build target (absolute path to a vault plugin folder)
.vault-plugin-path

examples/example-vault/.obsidian

# Local dev vault (wired via .vault-plugin-path)
vault/

# Test bundle, rebuilt on every `npm test`
tests/.build/

# Preview harness output
.preview/
