{
  "name": "callander-obsidian",
  "version": "1.4.1",
  "description": "Callander \u2014 a private secondary memory for your friendships, as an Obsidian plugin.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node tests/run.mjs",
    "preflight": "npm run lint && npm run build && npm test && npm run test:e2e",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "test:e2e": "node tests/e2e/run.mjs",
    "seed": "node tools/screenshots/make-seed.mjs",
    "screenshots": "node tools/screenshots/shoot.mjs",
    "preview": "node scripts/preview.mjs"
  },
  "keywords": [],
  "author": "zcallan",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@eslint/json": "0.14.0",
    "@types/node": "^16.11.6",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "obsidian": "1.13.1",
    "tslib": "2.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "ws": "^8.21.2",
    "yaml": "^2.9.0"
  }
}
