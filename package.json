{
	"name": "callander-obsidian",
	"version": "1.10.6",
	"private": true,
	"description": "Callander — a private secondary memory for your friendships, as an Obsidian plugin.",
	"main": "main.js",
	"scripts": {
		"dev": "node --watch --watch-preserve-output esbuild.config.mjs",
		"typecheck": "tsc",
		"build": "npm run typecheck && node esbuild.config.mjs production",
		"lint": "eslint . --max-warnings 0 && eslint -c eslint.node.config.mjs . --max-warnings 0",
		"lint:fix": "eslint . --fix && eslint -c eslint.node.config.mjs . --fix",
		"test": "node tests/run.mjs",
		"preflight": "npm run lint && npm run build && npm test && npm run check:icons && npm run test:e2e",
		"check:icons": "node tools/check-icons.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test:e2e": "node tests/e2e/run.mjs",
		"seed": "node tools/screenshots/make-seed.mjs",
		"screenshots": "node tools/screenshots/shoot.mjs",
		"screenshots:mobile": "node tools/screenshots/shoot-mobile.mjs",
		"preview": "node scripts/preview.mjs"
	},
	"keywords": [],
	"author": "zcallan",
	"license": "MIT",
	"engines": {
		"node": ">=20.11"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@eslint/json": "0.14.0",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"globals": "^14.0.0",
		"obsidian": "1.13.1",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.65.0",
		"ws": "^8.21.2",
		"yaml": "^2.9.0"
	},
	"dependencies": {
		"preact": "^10.29.8",
		"vanilla-colorful": "^0.7.2"
	}
}
