tag-version-prefix=""
# eslint-plugin-obsidianmd pins an exact `obsidian` peer; we intentionally
# track a newer obsidian for current API typings. The flag applies to every
# package, so peers npm would otherwise install for us have to be listed in
# package.json by hand: the obsidianmd plugin's (@eslint/js, @eslint/json,
# typescript-eslint), for one.
legacy-peer-deps=true
